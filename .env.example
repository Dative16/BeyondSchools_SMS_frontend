# Same origin in development: the Vite dev server proxies /api to the API on
# :8000. A cross-origin base URL will not carry the refresh cookie, which is
# SameSite=Lax, and every reload will sign you out.
VITE_API_BASE_URL=/api/v1

# Which school you are looking at. In production the server reads this off the
# host (mwenge.beyondschools.co.tz), and this is left unset. On localhost there
# is no subdomain, so name one here. Not a credential.
VITE_SCHOOL_SUBDOMAIN=mwenge

VITE_AI_PLATFORM_URL=https://aibeyondschools.co.tz
VITE_SENTRY_DSN=
